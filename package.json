{
  "name": "talelei-bracha-site",
  "private": true,
  "version": "0.2.0",
  "description": "אתר קרן טללי ברכה ובנות צילה + מערכת ניהול",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "vite build && node scripts/generate-sitemap.mjs",
    "test": "node --test server/mitchWorkflow.test.mjs",
    "check": "tsc --noEmit -p tsconfig.json && vite build",
    "start": "node server/index.mjs",
    "demo:seed": "node scripts/seed-demo.mjs",
    "demo:clear": "node scripts/clear-demo.mjs",
    "demo": "npm run demo:seed && DATABASE_URL= DATA_FILE=data/demo.json node scripts/dev.mjs"
  },
  "dependencies": {
    "pg": "^8.13.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
