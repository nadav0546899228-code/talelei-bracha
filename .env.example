# משתני סביבה - ב-Replit מגדירים ב-Secrets (לא בקובץ!)

# מזהה OAuth של Google לכניסת צוות (Google Cloud → Credentials → OAuth client ID מסוג Web)
GOOGLE_CLIENT_ID=

# מחרוזת אקראית ארוכה לחתימת עוגיות הכניסה (חובה באתר המפורסם)
SESSION_SECRET=

# נוצר אוטומטית ב-Replit כשמוסיפים מסד PostgreSQL
DATABASE_URL=

# אופציונלי - דריסת משתמשי היסוד (מופרדים בפסיק)
# DEVELOPER_EMAILS=nadav0546899228@gmail.com
# CEO_EMAILS=0542577001c@gmail.com

# לבדיקות מקומיות בלבד - כניסה בלי Google (לא פועל בסביבת ייצור)
# ALLOW_DEV_LOGIN=1

# לכתובות מלאות ב-sitemap.xml
# SITE_URL=https://example.org

# ימות המשיח - "מספר_מערכת:סיסמה" או מפתח API קבוע (שיחות קוליות, צינתוקים ו-SMS)
YEMOT_TOKEN=
